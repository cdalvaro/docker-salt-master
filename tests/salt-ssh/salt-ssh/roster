salt-ssh-root:
  host: salt-ssh-target
  user: root

# Same target as salt-ssh-root, reached through a network alias that is not in known_hosts
salt-ssh-new-host:
  host: salt-ssh-new-host
  user: root

# Password-only entry (priv: null): salt-ssh connects with StrictHostKeyChecking=no.
# Reached through a network alias that is not in known_hosts.
salt-ssh-password:
  host: salt-ssh-password-host
  user: root
  priv: null

# Reached through a network alias that the test pins to a different host key (changed host key)
salt-ssh-changed:
  host: salt-ssh-changed-host
  user: root

salt-ssh-changed-password:
  host: salt-ssh-changed-host
  user: root
  priv: null

salt-ssh-user:
  host: salt-ssh-target
  user: saltssh

salt-ssh-sudo:
  host: salt-ssh-target
  user: saltssh
  sudo: True
  # salt-ssh-user shares the default thin dir (/var/tmp/.saltssh_*_salt).
  # Use a dedicated one so root-owned files do not break non-sudo runs.
  thin_dir: /var/tmp/.saltssh_sudo_salt

# Target with a different Python version, used to test ssh_ext_alternatives
salt-ssh-python:
  host: salt-ssh-python-target
  user: root
